# Copy to server/.env and fill in.

# MongoDB connection string. Required when NODE_ENV=production. Leave unset in development
# to use an embedded MongoDB that stores its data in server/.data (no install needed).
# MONGODB_URI=mongodb://127.0.0.1:27017/eve

# Open apps and send WhatsApp messages on this Mac (requests from this Mac only).
# Default: on in development, off in production.
# LOCAL_ACTIONS=1

# Set to the number of proxies in front of the app (e.g. 1 behind nginx or a load balancer)
# so rate limits see real client IPs.
# TRUST_PROXY=0

PORT=5050
