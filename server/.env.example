# Copy to server/.env and fill in.

# MongoDB connection string. Required when NODE_ENV=production. Leave unset in development
# to use an embedded MongoDB that stores its data in server/.data (no install needed).
# MONGODB_URI=mongodb://127.0.0.1:27017/puffs

# Anthropic API key. Optional: without it the assistant uses its offline brain only.
# The key stays on the server and is never sent to the browser.
# ANTHROPIC_API_KEY=sk-ant-...

# Protect the Claude routes with a shared password (min 8 characters in production).
# Visitors unlock with:  /unlock <password>  in the assistant's text box.
# ACCESS_PASSWORD=

# Claude spend limits per UTC day (input + cache-write + output tokens).
# DEVICE_DAILY_TOKENS=150000
# DAILY_TOKEN_BUDGET=2000000
# Claude questions per minute, per IP and per device.
# CHAT_PER_MINUTE=12

# Open apps and send WhatsApp messages on this Mac (requests from this Mac only).
# Default: on in development, off in production.
# LOCAL_ACTIONS=1

# Set to the number of proxies in front of the app (e.g. 1 behind nginx or a load balancer)
# so rate limits see real client IPs.
# TRUST_PROXY=0

PORT=5050
